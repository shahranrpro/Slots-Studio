# Slots Studio — Environment Configuration Example
# Copy this file to .env.local for local development.
# Never commit real secrets or production keys into version control.

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Slots Studio"

# Authentication (Active in Task 07)
AUTH_SECRET="your-development-auth-secret-min-32-chars-placeholder"

# Optional Local Development Account (Local development only)
DEV_AUTH_EMAIL="developer@slots.studio"
DEV_AUTH_PASSWORD="your-local-dev-password-min-8-chars"

# Database & Supabase (Phase 3.1)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/slots_studio"

# Cloudflare R2 Storage (Phase 3.2)
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="slots-studio-assets"
R2_ENDPOINT="https://your-r2-account-id.r2.cloudflarestorage.com"
STORAGE_BUCKET="slots-studio-development-bucket"

# AI Providers & Generation Engine (Phase 3.3)
# The application automatically falls back to DEV PREVIEW deterministic generation if keys are absent.
# All keys remain strictly server-side and are NEVER exposed to browser bundles.

# Text Generation Providers (Choose one or leave blank for local DEV PREVIEW fallback):
# Google Gemini (Free tier, gemini-1.5-flash)
GEMINI_API_KEY=""
# Groq (Free dev tier, llama-3.3-70b-versatile)
GROQ_API_KEY=""
# OpenAI (gpt-4o-mini, gpt-4o)
OPENAI_API_KEY=""
# Local Ollama (100% private, on-premise)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_ENABLED="false"

# Image Generation Providers:
# Pollinations (Flux open compute, zero-cost, active by default)
POLLINATIONS_DISABLED="false"

# Explicit Provider Selection (optional override):
# AI_TEXT_PROVIDER="gemini" # Options: gemini | groq | openai | ollama | dev
# AI_IMAGE_PROVIDER="pollinations" # Options: pollinations | openai | dev

# Server-Side Free Tier Quota Limits:
FREE_TIER_TEXT_LIMIT="20"
FREE_TIER_IMAGE_LIMIT="5"

# Transactional Email Engine (Phase 3.6)
# If no key is set or EMAIL_PROVIDER="dev", the app defaults to honest DEV PREVIEW mock email logging.
RESEND_API_KEY=""
EMAIL_FROM="Slots Studio <notifications@slots.studio>"
EMAIL_PROVIDER="resend" # Options: resend | dev

# Billing Provider (Reserved for future phase)
BILLING_SECRET="placeholder_billing_secret"

